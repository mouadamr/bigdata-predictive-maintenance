    {
      "id": 7,
      "type": "piechart",
      "title": "Repartition des etats de sante",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "pm-postgres"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 8,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "pm-postgres"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT\n  SUM(CASE WHEN etat_predit = 'Sain' THEN 1 ELSE 0 END) AS \"Sain\",\n  SUM(CASE WHEN etat_predit = 'A surveiller' THEN 1 ELSE 0 END) AS \"A surveiller\",\n  SUM(CASE WHEN etat_predit = 'Critique' THEN 1 ELSE 0 END) AS \"Critique\"\nFROM flotte_sante"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "none"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Sain"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {

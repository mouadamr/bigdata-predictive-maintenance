            "type": "grafana-postgresql-datasource",
            "uid": "pm-postgres"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT engine_id AS \"Moteur\", dernier_cycle AS \"Cycle actuel\",\n       rul_predite AS \"RUL predite\", etat_predit AS \"Etat\",\n       proba_critique AS \"Proba. critique\", rul_reelle AS \"RUL reelle\",\n       CASE WHEN etat_predit = 'Critique' THEN 'Arret et maintenance immediate'\n            ELSE 'Planifier la maintenance' END AS \"Action\"\nFROM flotte_sante\nWHERE etat_predit <> 'Sain'\nORDER BY priorite, rul_predite"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "center",
            "cellOptions": {
              "type": "auto"
            }
